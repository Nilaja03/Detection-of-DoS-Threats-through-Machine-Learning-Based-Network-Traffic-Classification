      "source": [
        "# Install LocalTunnel (Node.js is available in standard Colab runtimes)\n",
        "!npm -q install -g localtunnel\n",
        "\n",
        "import subprocess, time, os, textwrap, requests\n",
        "# Start Streamlit in the background\n",
        "streamlit_log = open(\"/content/streamlit.log\", \"w\")\n",
        "streamlit_proc = subprocess.Popen(\n",
        "    [\"streamlit\", \"run\", \"/content/app.py\",\n",
        "     \"--server.port\", \"8501\",\n",
        "     \"--server.address\", \"0.0.0.0\",\n",
        "     \"--server.headless\", \"true\"],\n",
        "    stdout=streamlit_log, stderr=subprocess.STDOUT\n",
        ")\n",
        "time.sleep(8)\n",
        "\n",
        "# Start LocalTunnel and print its output/URL\n",
        "tunnel_proc = subprocess.Popen(\n",
        "    [\"lt\", \"--port\", \"8501\"],\n",
        "    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True\n",
        ")\n",
        "time.sleep(5)\n",
        "print(\"Streamlit log:\")\n",
        "print(open(\"/content/streamlit.log\").read()[-2500:])\n",
        "print(\"\\nLocalTunnel output:\")\n",
        "try:\n",
        "    print(tunnel_proc.stdout.readline().strip())\n",
        "except Exception as e:\n",
        "    print(\"Tunnel output not available yet:\", e)\n",
        "print(\"\\nIf no URL appeared, run: !lt --port 8501\")"
      ]
    },
