      "cell_type": "code",
      "source": [
        "import subprocess\n",
        "import time\n",
        "import re\n",
        "import requests\n",
        "\n",
        "# Verify Streamlit is still running\n",
        "response = requests.get(\n",
        "    \"http://127.0.0.1:8501\",\n",
        "    timeout=10\n",
        ")\n",
        "\n",
        "print(\"Streamlit status:\", response.status_code)\n",
        "\n",
        "# Start Cloudflare Tunnel\n",
        "tunnel = subprocess.Popen(\n",
        "    [\n",
        "        \"cloudflared\",\n",
        "        \"tunnel\",\n",
        "        \"--url\",\n",
        "        \"http://127.0.0.1:8501\",\n",
        "        \"--no-autoupdate\"\n",
        "    ],\n",
        "    stdout=subprocess.PIPE,\n",
        "    stderr=subprocess.STDOUT,\n",
        "    text=True\n",
        ")\n",
        "\n",
        "public_url = None\n",
        "\n",
        "for _ in range(60):\n",
        "    line = tunnel.stdout.readline()\n",
        "\n",
        "    if line:\n",
        "        print(line.strip())\n",
        "\n",
        "        match = re.search(\n",
        "            r\"https://[a-zA-Z0-9-]+\\.trycloudflare\\.com\",\n",
        "            line\n",
        "        )\n",
        "\n",
        "        if match:\n",
        "            public_url = match.group(0)\n",
        "            break\n",
        "\n",
        "if public_url:\n",
        "    print(\"\\nYOUR STREAMLIT DASHBOARD:\")\n",
        "    print(public_url)\n",
        "else:\n",
        "    print(\"Tunnel URL not detected. Check the output above.\")"
      ],
