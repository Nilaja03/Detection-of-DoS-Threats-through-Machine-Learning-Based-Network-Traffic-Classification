              "summary": "{\n  \"name\": \"print(\\\"Ready for Random Forest training\",\n  \"rows\": 3,\n  \"fields\": [\n    {\n      \"column\": \"Class\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          \"BENIGN\",\n          \"DoS\",\n          \"PortScan\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Rows\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0,\n        \"min\": 10000,\n        \"max\": 10000,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          10000\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
            }
          },
          "metadata": {}
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Total training records: 30,000\n",
            "Ready for Random Forest training.\n"
          ]
        }
      ],
      "source": [
        "import os, re, json, warnings, time\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score, classification_report,\n",
        "    confusion_matrix, ConfusionMatrixDisplay\n",
        ")\n",
        "import joblib\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "FEATURES = [\n",
        "    \"Destination Port\",\n",
        "    \"Flow Duration\",\n",
        "    \"Total Fwd Packets\",\n",
        "    \"Total Backward Packets\",\n",
        "    \"Flow Bytes/s\",\n",
        "]\n",
        "\n",
        "MODEL_PATH = \"/content/threat_detector.joblib\"\n",
        "METRICS_PATH = \"/content/model_metrics.json\"\n",
        "MAX_ROWS_PER_CLASS = 10000\n",
        "\n",
        "def normalize_column(name):\n",
        "    return re.sub(r\"\\s+\", \" \", str(name).replace(\"\\ufeff\", \"\").strip()).lower()\n",
        "\n",
        "def normalize_label(label):\n",
        "    value = str(label).strip().lower()\n",
        "    if value == \"benign\":\n",
        "        return \"BENIGN\"\n",
        "    if \"portscan\" in value or \"port scan\" in value:\n",
        "        return \"PortScan\"\n",
        "    if value in {\"dos hulk\", \"dos slowloris\"}:\n",
        "        return \"DoS\"\n",
        "    return None\n",
        "\n",
        "# Convert the Hugging Face Dataset to a DataFrame after it has been downloaded.\n",
        "print(\"Converting the downloaded dataset to a DataFrame...\")\n",
        "data = hf_dataset.to_pandas()\n",
        "print(f\"Loaded {len(data):,} rows.\")\n",
        "print(\"Original columns:\", list(data.columns))\n",
        "\n",
        "# Normalize column names and support common CICFlowMeter variants.\n",
        "column_lookup = {normalize_column(c): c for c in data.columns}\n",
        "aliases = {\n",
        "    \"Destination Port\": [\"destination port\", \"dst port\"],\n",
        "    \"Flow Duration\": [\"flow duration\"],\n",
        "    \"Total Fwd Packets\": [\"total fwd packets\", \"tot fwd pkts\"],\n",
        "    \"Total Backward Packets\": [\"total backward packets\", \"tot bwd pkts\"],\n",
        "    \"Flow Bytes/s\": [\"flow bytes/s\", \"flow byts/s\", \"flow bytes per second\"],\n",
        "    \"Label\": [\"label\"],\n",
        "}\n",
        "\n",
        "rename_map = {}\n",
        "for wanted, candidates in aliases.items():\n",
        "    for candidate in candidates:\n",
        "        if candidate in column_lookup:\n",
        "            rename_map[column_lookup[candidate]] = wanted\n",
        "            break\n",
        "\n",
        "data = data.rename(columns=rename_map)\n",
        "\n",
        "required = FEATURES + [\"Label\"]\n",
        "missing = [c for c in required if c not in data.columns]\n",
        "if missing:\n",
        "    raise ValueError(\n",
        "        f\"Dataset is missing required columns: {missing}. \"\n",
        "        f\"Available columns: {list(data.columns)}\"\n",
        "    )\n",
        "\n",
        "print(\"Mapping original labels to project classes...\")\n",
        "data[\"Target\"] = data[\"Label\"].astype(str).str.strip().map(normalize_label)\n",
        "\n",
        "# Keep only BENIGN, PortScan, DoS Hulk and DoS Slowloris.\n",
        "data = data.dropna(subset=[\"Target\"]).copy()\n",
        "print(\"Rows after selecting project classes:\", f\"{len(data):,}\")\n",
        "print(\"Available selected labels:\")\n",
        "display(data[\"Label\"].value_counts().to_frame(\"Rows\"))\n",
        "\n",
        "print(\"Converting selected model features to numeric values...\")\n",
        "for col in FEATURES:\n",
        "    data[col] = pd.to_numeric(data[col], errors=\"coerce\")\n",
        "\n",
        "data.replace([np.inf, -np.inf], np.nan, inplace=True)\n",
        "data.dropna(subset=FEATURES, inplace=True)\n",
        "\n",
        "# Sample each project class independently, so class order in the source\n",
        "# cannot prevent PortScan/DoS from being collected.\n",
        "sampled_parts = []\n",
        "for class_name in [\"BENIGN\", \"PortScan\", \"DoS\"]:\n",
        "    class_rows = data[data[\"Target\"] == class_name]\n",
        "    if class_rows.empty:\n",
        "        raise ValueError(\n",
        "            f\"No rows found for {class_name}. \"\n",
        "            \"Inspect the original dataset labels shown above.\"\n",
        "        )\n",
        "    n = min(MAX_ROWS_PER_CLASS, len(class_rows))\n",
        "    sampled = class_rows.sample(n=n, random_state=42)\n",
        "    sampled_parts.append(sampled)\n",
        "    print(f\"{class_name}: selected {n:,} of {len(class_rows):,} valid rows\")\n",
        "\n",
        "model_data = pd.concat(sampled_parts, ignore_index=True)\n",
        "model_data = model_data.sample(frac=1, random_state=42).reset_index(drop=True)\n",
        "\n",
        "print(\"\\nFinal class distribution:\")\n",
        "display(model_data[\"Target\"].value_counts().rename_axis(\"Class\").to_frame(\"Rows\"))\n",
        "print(\"Total training records:\", f\"{len(model_data):,}\")\n",
        "print(\"Ready for Random Forest training.\")"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "ea15907d",
      "metadata": {
        "id": "ea15907d"
      },
      "source": [
        "## 3. Train and evaluate the Random Forest model\n",
        "\n",
        "This is a supervised multi-class classifier. The dataset labels are grouped into the three project classes: BENIGN, PortScan and DoS. A stratified holdout set is used for evaluation."
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "X = model_data[FEATURES].astype(\"float32\")\n",
        "y = model_data[\"Target\"]\n",
        "\n",
        "if y.nunique() < 2:\n",
        "    raise ValueError(\"At least two target classes are required. Upload additional CIC-IDS2017 CSVs containing BENIGN, PortScan and/or DoS.\")\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y, test_size=0.20, random_state=42, stratify=y\n",
        ")\n",
        "\n",
        "rf_model = RandomForestClassifier(\n",
        "    n_estimators=180,\n",
        "    max_depth=24,\n",
        "    min_samples_split=4,\n",
        "    min_samples_leaf=2,\n",
        "    class_weight=\"balanced_subsample\",\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
        ")\n",
        "rf_model.fit(X_train, y_train)\n",
        "\n",
        "y_pred = rf_model.predict(X_test)\n",
        "accuracy = accuracy_score(y_test, y_pred)\n",
        "report = classification_report(y_test, y_pred, output_dict=True, zero_division=0)\n",
        "print(f\"Holdout accuracy: {accuracy:.4f}\")\n",
        "print(classification_report(y_test, y_pred, zero_division=0))\n",
        "\n",
        "metrics = {\n",
        "    \"accuracy\": float(accuracy),\n",
        "    \"classification_report\": report,\n",
        "    \"classes\": list(rf_model.classes_),\n",
        "    \"features\": FEATURES,\n",
        "    \"training_rows\": int(len(X_train)),\n",
        "    \"testing_rows\": int(len(X_test))\n",
        "}\n",
        "with open(METRICS_PATH, \"w\") as f:\n",
        "    json.dump(metrics, f, indent=2)\n",
        "\n",
        "joblib.dump({\"model\": rf_model, \"features\": FEATURES}, MODEL_PATH)\n",
        "print(f\"Saved model: {MODEL_PATH}\")"
      ],
      "metadata": {
